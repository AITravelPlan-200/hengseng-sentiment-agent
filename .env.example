# ==============================================================================
# HengSeng Sentiment Price Prediction Agent - Environment Configuration
# ==============================================================================

# Apify API Token (Required for social scraping actors: LIHKG, Telegram, Naver, Daum)
# Sign up at https://apify.com to obtain your API token
APIFY_API_TOKEN=your_apify_api_token_here

# Exa AI API Key (Required for high-precision financial news retrieval)
# Sign up at https://exa.ai to obtain your API key
EXA_API_KEY=your_exa_api_key_here

# Tavily Search API Key (Optional supplementary search provider)
# Sign up at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# HuggingFace Token (Optional, for downloading gated or higher rate-limit models)
HUGGINGFACE_API_KEY=

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_PATH=database/hengseng.db

# Scraping & Ingestion Settings
MAX_DAYS_HISTORY=10
NEWS_LOOKBACK_DAYS=7
PRICE_HISTORY_YEARS=2
USE_SAMPLE_FALLBACK=true
